/* ==========================================
 THE TERMINAL FSM: SMART HOME DASHBOARD
 ========================================== */

// 1. GLOBAL STATE
bool lightsOn = false;
int roomTemp = 22;
int masterPin = 1234;
[string] accessLogs = ["System Booted", "Thermostat Initialized"];

// 2. DATA-DRIVEN WATCHERS (react)
react (lightsOn) {
    string status = (lightsOn == true) ? "illuminated" : "extinguished";
    print("[SYSTEM EVENT] Living room lights " + status + ".");
}

react (roomTemp) {
    print("[SYSTEM EVENT] Thermostat calibrated to " + roomTemp + "C.");
}

// 3. CUSTOM FUNCTIONS (fn)
fn formatStatus(bool status) -> string {
    return (status == true) ? "ACTIVE" : "INACTIVE";
}

fn removeSpaces(string text) -> string {
    return replace(text, " ", "");
}

// 4. ISOLATED STATES (state & transition)
state Boot {
    print("--- SYSTEM LOCKED ---");
    print("Enter 4-digit numeric PIN:");
    
    int? input = readInt();
    
    // ensure explicitly declaring the type of the new variable
    int pin = ensure input else {
        print("[ERROR] PIN must contain only numbers.");
        transition to Boot;
    }
    
    if (pin == masterPin) {
        print("Access granted.");
        transition to Dashboard;
    } else {
        print("Incorrect PIN.");
        transition to Boot;
    }
}

state Dashboard {
    print("\n--- IOT MAIN MENU ---");
    print("1: Toggle Lights");
    print("2: Set Temperature");
    print("3: View System Status");
    print("4: Lock System");
    
    loop {
        print("\nSelect an action (1-4):");
        
        // Pipeline used purely for string manipulation
        string choice = readLine() |> removeSpaces();
        
        match choice {
            "1" -> transition to LightControl;
            "2" -> transition to TempControl;
            "3" -> transition to StatusView;
            "4" -> transition to Boot;
            ""  -> print("");
            _   -> print("Unknown command.");
        }
    }
}

state LightControl {
    lightsOn = (lightsOn == true) ? false : true;
    transition to Dashboard;
}

state TempControl {
    print("\nCurrent temperature is " + roomTemp + "C.");
    
    loop {
        print("Enter new target temperature (-99 to cancel):");
        
        int? newTemp = readInt();
        
        int validTemp = ensure newTemp else {
            print("[ERROR] Temperature must be a number.");
            transition to TempControl;
        }
        
        if (validTemp == -99) {
            transition to Dashboard;
        } else if (validTemp < 16) {
            print("Error: Minimum temperature is 16C.");
        } else if (validTemp > 30) {
            print("Error: Maximum temperature is 30C.");
        } else {
            roomTemp = validTemp;
            transition to Dashboard;
        }
    }
}

state StatusView {
    print("\n--- SYSTEM STATUS ---");
    
    string lightDisplay = lightsOn |> formatStatus();
    print("Lights: " + lightDisplay);
    print("Thermostat: " + roomTemp + "C");
    
    print("\n--- RECENT LOGS ---");
    for (int i = 0; i < length(accessLogs); i += 1) {
        print("- Log " + i + ": " + accessLogs[i]);
    }
    
    print("\nPress Enter to return to Dashboard.");
    string wait = readLine();
    
    transition to Dashboard;
}

// 5. ADDITIONAL LANGUAGE FEATURES FROM Fidelis.md
state LanguageFeatureShowcase {
    // Arrays, indexing, assignment, and both length forms described in the spec.
    [int] scores = [90, 85, 88];
    int scoreCount = length(scores);
    int scoreCountByProperty = scores.length;
    scores[1] = 95;


    // Optional primitive and array types, null, and ensure-based unwrapping.
    int? optionalScore = null;
    float? optionalWeight = null;
    bool? optionalFlag = null;
    char? optionalInitial = null;
    string? optionalName = readLine();
    [int]? optionalScores = null;

    string confirmedName = ensure optionalName else {
        print("No name was entered.");
        transition to Dashboard;
    }

    // Character and string escapes are retained in the lexeme.
    char newline = '\n';
    string quotedText = "She said: \"hello\"";

    // Arithmetic, relational, logical, and compound assignment operators.
    int calculation = -(2 ^ 3) + 10 / 2 \ 2 % 3;
    calculation += 1;
    calculation -= 1;
    calculation *= 2;
    calculation /= 2;
    calculation %= 5;

    bool withinRange = scoreCount >= 1 && scoreCountByProperty <= 10;
    bool differs = calculation != 0 || !withinRange;

    // Nested iteration and a multi-statement match case.
    for (int x = 1; x <= 2; x += 1) {
        for (int y = 1; y <= 2; y += 1) {
            print("Coordinate: (" + x + ", " + y + ")");
        }
    }

    match confirmedName {
        "Ada" -> {
            print("Welcome, Ada.");
            transition to Dashboard;
        }
        _ -> print("Welcome, " + confirmedName);
    }
}

// System commands documented in Fidelis.md.
sleep(100);
quit;
