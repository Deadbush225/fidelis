// Linear search checks each item from left to right.
fn linearSearch([int] values, int target) -> int {
    for (int index = 0; index < values.length; index += 1) {
        if (values[index] == target) {
            return index;
        }
    }

    return -1;
}

// Binary search requires the input array to be sorted.
fn binarySearch([int] values, int target) -> int {
    int low = 0;
    int high = values.length - 1;

    loop {
        if (low > high) {
            return -1;
        }

        int middle = (low + high) / 2;

        if (values[middle] == target) {
            return middle;
        } else if (values[middle] < target) {
            low = middle + 1;
        } else {
            high = middle - 1;
        }
    }
}

[int, 7] values = [3, 8, 14, 21, 29, 42, 57];
int target = 21;
int linearResult = linearSearch(values, target);
int binaryResult = binarySearch(values, target);

print("Linear search index: " + linearResult);
print("Binary search index: " + binaryResult);
