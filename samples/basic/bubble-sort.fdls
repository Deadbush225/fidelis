// Bubble sort repeatedly swaps adjacent values that are out of order.
[int, 7] numbers = [64, 34, 25, 12, 22, 11, 90];
int itemCount = numbers.length;

for (int i = 0; i < itemCount - 1; i += 1) {
    for (int j = 0; j < itemCount - i - 1; j += 1) {
        if (numbers[j] > numbers[j + 1]) {
            int temporary = numbers[j];
            numbers[j] = numbers[j + 1];
            numbers[j + 1] = temporary;
        }
    }
}

print("Sorted numbers:");
for (int i = 0; i < itemCount; i += 1) {
    print(numbers[i]);
}