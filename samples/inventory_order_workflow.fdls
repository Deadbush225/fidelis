/*
 * Inventory and order desk
 * Demonstrates sign-in, reactive stock, stock adjustment, checkout,
 * functions, input validation, and state transitions
 */

int employeePin = 4721;
int orderNumber = 8042;
int coffeeStock = 18;
int teaStock = 7;
int cocoaStock = 0;
float coffeePrice = 12.50;
float teaPrice = 8.25;
float cocoaPrice = 15.00;
float taxRate = 0.0825;
float discountRate = 0.10;
bool storeOpen = true;

react (coffeeStock) {
    print("[STOCK] Coffee inventory changed.");
}

react (teaStock) {
    print("[STOCK] Tea inventory changed.");
}

react (cocoaStock) {
    print("[STOCK] Cocoa inventory changed.");
}

fn calculateTotal(float unitPrice, int quantity) -> float {
    float subtotal = unitPrice * quantity;
    float discount = subtotal * discountRate;
    float taxedTotal = (subtotal - discount) * (1.0 + taxRate);
    return taxedTotal;
}

fn stockLabel(int quantity) -> string {
    if (quantity == 0) {
        return "OUT OF STOCK";
    } else if (quantity <= 3) {
        return "LOW STOCK";
    } else {
        return "AVAILABLE";
    }
}

fn clampStock(int quantity) -> int {
    if (quantity < 0) {
        return 0;
    } else if (quantity > 999) {
        return 999;
    } else {
        return quantity;
    }
}

state SignIn {
    print("Employee PIN:");
    int? enteredPin = readInt();

    int pin = ensure enteredPin else {
        print("PIN must contain digits.");
        transition to SignIn;
    }

    if (pin == employeePin && storeOpen) {
        print("Welcome to the inventory desk.");
        transition to Inventory;
    } else {
        print("Sign-in failed or the store is closed.");
        transition to SignIn;
    }
}

state Inventory {
    print("--- INVENTORY ---");
    print("Coffee: " + stockLabel(coffeeStock) + " (" + coffeeStock + ")");
    print("Tea: " + stockLabel(teaStock) + " (" + teaStock + ")");
    print("Cocoa: " + stockLabel(cocoaStock) + " (" + cocoaStock + ")");
    print("1: Adjust stock  2: New order  3: Close register");

    string action = readLine();
    match action {
        "1" -> transition to StockAdjustment;
        "2" -> transition to Checkout;
        "3" -> transition to CloseRegister;
        _ -> {
            print("Unknown action.");
            transition to Inventory;
        }
    }
}

state StockAdjustment {
    print("Product number: 1 Coffee, 2 Tea, 3 Cocoa");
    string product = readLine();
    match product {
        "1" -> transition to AdjustCoffee;
        "2" -> transition to AdjustTea;
        "3" -> transition to AdjustCocoa;
        _ -> {
            print("Unknown product.");
            transition to Inventory;
        }
    }
}

state AdjustCoffee {
    print("Stock change (negative values remove stock):");
    int? changeInput = readInt();
    int change = ensure changeInput else {
        print("Stock change must be an integer.");
        transition to AdjustCoffee;
    }
    coffeeStock = clampStock(coffeeStock + change);
    print("Coffee stock is now " + coffeeStock);
    transition to Inventory;
}

state AdjustTea {
    print("Stock change (negative values remove stock):");
    int? changeInput = readInt();
    int change = ensure changeInput else {
        print("Stock change must be an integer.");
        transition to AdjustTea;
    }
    teaStock = clampStock(teaStock + change);
    print("Tea stock is now " + teaStock);
    transition to Inventory;
}

state AdjustCocoa {
    print("Stock change (negative values remove stock):");
    int? changeInput = readInt();
    int change = ensure changeInput else {
        print("Stock change must be an integer.");
        transition to AdjustCocoa;
    }
    cocoaStock = clampStock(cocoaStock + change);
    print("Cocoa stock is now " + cocoaStock);
    transition to Inventory;
}

state Checkout {
    print("Product number: 1 Coffee, 2 Tea, 3 Cocoa");
    string product = readLine();
    match product {
        "1" -> transition to CheckoutCoffee;
        "2" -> transition to CheckoutTea;
        "3" -> transition to CheckoutCocoa;
        _ -> {
            print("Unknown product.");
            transition to Inventory;
        }
    }
}

state CheckoutCoffee {
    print("Quantity:");
    int? quantityInput = readInt();
    int quantity = ensure quantityInput else {
        print("Quantity must be an integer.");
        transition to CheckoutCoffee;
    }
    if (quantity <= 0) {
        print("Quantity must be greater than zero.");
        transition to Inventory;
    } else if (quantity > coffeeStock) {
        print("Quantity exceeds available coffee stock.");
        transition to Inventory;
    } else {
        float total = calculateTotal(coffeePrice, quantity);
        coffeeStock -= quantity;
        orderNumber += 1;
        print("Order " + orderNumber + " total: $" + total);
        transition to Inventory;
    }
}

state CheckoutTea {
    print("Quantity:");
    int? quantityInput = readInt();
    int quantity = ensure quantityInput else {
        print("Quantity must be an integer.");
        transition to CheckoutTea;
    }
    if (quantity <= 0) {
        print("Quantity must be greater than zero.");
        transition to Inventory;
    } else if (quantity > teaStock) {
        print("Quantity exceeds available tea stock.");
        transition to Inventory;
    } else {
        float total = calculateTotal(teaPrice, quantity);
        teaStock -= quantity;
        orderNumber += 1;
        print("Order " + orderNumber + " total: $" + total);
        transition to Inventory;
    }
}

state CheckoutCocoa {
    print("Quantity:");
    int? quantityInput = readInt();
    int quantity = ensure quantityInput else {
        print("Quantity must be an integer.");
        transition to CheckoutCocoa;
    }
    if (quantity <= 0) {
        print("Quantity must be greater than zero.");
        transition to Inventory;
    } else if (quantity > cocoaStock) {
        print("Quantity exceeds available cocoa stock.");
        transition to Inventory;
    } else {
        float total = calculateTotal(cocoaPrice, quantity);
        cocoaStock -= quantity;
        orderNumber += 1;
        print("Order " + orderNumber + " total: $" + total);
        transition to Inventory;
    }
}

state CloseRegister {
    print("Register closed.");
}
