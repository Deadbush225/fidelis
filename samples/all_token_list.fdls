// ==========================================
// PURE TOKEN INVENTORY LIST
// ==========================================

// Line comment
/* Multi-line 
   block comment */

// Data Types
int float string bool char

// Boolean & Null Literals
true false null

// Literals & Identifiers
42 3.14 'Z' "Hello Fidelis" customIdentifier

// Structural & Control Keywords
state react loop
if else for match transition ensure

// Functions & System Keywords
fn return print readLine readInt quit sleep

// Noise Words
is do to

// Arithmetic Operators
+ - * / % \ ^

// Relational Operators
== != < > <= >=

// Logical Operators
! && ||

// Assignment & Compound Operators
= += -= *= /= %=

// Pipeline, Arrow, Optional, and Dot
|> -> ? .

// Delimiters & Grouping
; , :
( ) { } [ ]